{
  "rules": {
    "rooms": {
      ".read": "auth != null",
      ".indexOn": ["status"],
      "$code": {
        ".write": "auth != null && (data.exists() ? data.child('host').val() === auth.uid : newData.child('host').val() === auth.uid)",
        ".validate": "!newData.exists() || newData.hasChildren(['host', 'status', 'created'])",
        "guest": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || data.child('uid').val() === auth.uid)"
        }
      }
    },
    "relay": {
      "$code": {
        ".read": "auth != null && (root.child('rooms/' + $code + '/host').val() === auth.uid || root.child('rooms/' + $code + '/guest/uid').val() === auth.uid)",
        ".write": "auth != null && (root.child('rooms/' + $code + '/host').val() === auth.uid || root.child('rooms/' + $code + '/guest/uid').val() === auth.uid)"
      }
    }
  }
}
